# Variables d'environnement pour User Service (:8081)
# Copier ce fichier sous le nom '.env' et personnaliser les valeurs pour chaque environnement.

# Clé secrète JWT partagée (min 256 bits / 32 caractères)
JWT_SECRET=MaSuperCleSecreteDe256BitsPourSignerMesTokensEnTouteSecurite!

# Durée de validité du token en ms (86400000 = 24h)
JWT_EXPIRATION=86400000
